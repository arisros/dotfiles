# ── sandi ────────────────────────────────────────────────────────────────────
# Thin wrapper around pass. Anything it does not recognise is forwarded
# straight through, so `sandi show`, `sandi find`, `sandi insert` and
# `sandi git` behave exactly like the pass equivalents. Two additions:
#
#   sandi sync    pull --rebase then push
#   sandi st      print the sync state
#
# The store itself, the gpg keys and the remote are not configured here.
# Set SANDI_REMOTE per machine in ~/.config/dotfiles/modules/sandi.zsh and run
# __scripts__/sandi-setup.sh.

: "${SANDI_DOTFILES:=$HOME/dotfiles}"
: "${SANDI_STATE_SCRIPT:=$SANDI_DOTFILES/__scripts__/sandi-state.sh}"

sandi() {
  command -v pass >/dev/null 2>&1 || { printf 'sandi: pass not found\n' >&2; return 1; }
  case "${1:-}" in
    sync)
      shift
      _sandi_sync "$@"
      ;;
    st|status)
      shift
      _sandi_status "$@"
      ;;
    env)
      shift
      _sandi_env "$@"
      ;;
    *)
      pass "$@"
      ;;
  esac
}

_sandi_store() {
  printf '%s\n' "${PASSWORD_STORE_DIR:-$HOME/.password-store}"
}

_sandi_sync() {
  local store
  store="$(_sandi_store)"
  if ! git -C "$store" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'sandi: %s is not a git repository, run sandi-setup.sh\n' "$store" >&2
    return 1
  fi
  if ! git -C "$store" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    printf 'sandi: no upstream configured, run sandi-setup.sh\n' >&2
    return 1
  fi
  pass git pull --rebase --quiet || return 1
  pass git push --quiet || return 1
  printf 'sandi: synced\n'
}

# sandi env VAR=entry [VAR=entry ...] -- command [args...]
#
# Resolves each entry and runs command with those variables set, and nothing
# else changed. The values live in that one process and are never written to
# disk, which is the whole point: a secret needed by one tool should not sit
# in every shell's environment, let alone in a file.
#
# A missing entry is a warning, not a failure, so a tool that only needs two
# of three keys still starts.
_sandi_env() {
  local -a assignments envargs
  local arg name entry value
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      *=*) assignments+=("$1"); shift ;;
      *) printf 'sandi env: expected VAR=entry or --, got %s\n' "$1" >&2; return 1 ;;
    esac
  done
  if [ "$#" -eq 0 ]; then
    printf 'sandi env: no command given after --\n' >&2
    return 1
  fi
  for arg in "${assignments[@]}"; do
    name="${arg%%=*}"
    entry="${arg#*=}"
    value="$(pass show "$entry" 2>/dev/null | head -1)"
    if [ -z "$value" ]; then
      printf 'sandi env: %s is not in the store, %s left unset\n' "$entry" "$name" >&2
      continue
    fi
    envargs+=("$name=$value")
  done
  if [ "${#envargs[@]}" -eq 0 ]; then
    "$@"
    return
  fi
  env "${envargs[@]}" "$@"
}

_sandi_status() {
  if [ ! -x "$SANDI_STATE_SCRIPT" ]; then
    printf 'sandi: %s not found\n' "$SANDI_STATE_SCRIPT" >&2
    return 1
  fi
  "$SANDI_STATE_SCRIPT" "$@"
}
