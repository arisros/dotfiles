# vars
workdir=~/work
lora_dir=$workdir/lora/lora-workspace/services
lora_toolkit_dir=$lora_dir/real-atletico

# ── Helper: resolve service dir (worktree if active, else services/) ──────────
# LORA_WORKTREE_BASE is injected by tmux when a new pane is spawned inside a
# lora-session. Each function below checks it at call time, so no szz needed.
_lora_svc_dir() {
  local svc="$1"
  if [[ -n "${LORA_WORKTREE_BASE:-}" && -d "$LORA_WORKTREE_BASE/$svc" ]]; then
    echo "$LORA_WORKTREE_BASE/$svc"
  else
    echo "$lora_dir/$svc"
  fi
}
# uw doc
uwdoc10() {
  lora-schemagen -d -s 'http://localhost:8080/json-schema/business/document/dp-ndf-uw-v0_10_0.schema.json?bundled=1' \
    -t "/Users/mac-098183/work/lora/lora-workspace/services/lora-partnership-task-ndf/internal/process/document"
}
# ── Navigation ────────────────────────────────────────────────────────────────
alias glc="cd $lora_dir/lora-collection"
alias gltn="cd $lora_dir/lora-tools-nix"


unalias glss 2>/dev/null || true

glss()    { cd "$(_lora_svc_dir lora-schema-service)"; }
glgs()    { cd "$(_lora_svc_dir lora-gateway-service)"; }
glts()    { cd "$(_lora_svc_dir lora-task-service)"; }
glbofe()  { cd "$(_lora_svc_dir lora-backoffice-fe)"; }
glndfw()  { cd "$(_lora_svc_dir lora-partnership-ndf)"; }
glndftw() { cd "$(_lora_svc_dir lora-partnership-task-ndf)"; }
glt()     { cd "$(_lora_svc_dir lora-tools)"; }
# unalias gl before redefining as function (git_aliases defines gl='git pull')
unalias gl 2>/dev/null || true
gl() {
  if [[ -n "${LORA_WORKTREE_BASE:-}" && -d "$LORA_WORKTREE_BASE" ]]; then
    cd "$LORA_WORKTREE_BASE"
  else
    cd "$lora_dir"
  fi
}

# ── Run services ──────────────────────────────────────────────────────────────
rlss()    { glss    && export $(grep -v '^#' .env | xargs -0) && HTTP_SERVER_PORT=8080 go run -trimpath cmd/http/main.go; }
rlgs()    { glgs    && export $(grep -v '^#' .env | xargs -0) && HTTP_SERVER_PORT=8081 go run -trimpath cmd/http/main.go; }
rlts()    { glts    && export $(grep -v '^#' .env | xargs -0) && go run -trimpath cmd/http/main.go; }
rlbofe()  { glbofe  && pnpm run dev; }
rlndfw()  { glndfw  && export $(grep -v '^#' .env | xargs -0) && go run -trimpath cmd/main.go; }
rlndftw() { glndftw && export $(grep -v '^#' .env | xargs -0) && go run -trimpath cmd/main.go; }

# run all services one command
alias rlora="gl && ./real_atletico/run_services.sh"

# ── ArangoDB shell ────────────────────────────────────────────────────────────
alias arango="tmux split-window -h -p 30 'nvim $lora_toolkit_dir/arango_cht.sh' && docker exec -it arangodb arangosh"

# ── Schema codegen (targets worktree path when active) ───────────────────────
pwdoc() {
  lora-schemagen -d -s 'http://localhost:8080/json-schema/business/document/dp-ndf-v0_8_0.schema.json?bundled=1' \
    -t "$(_lora_svc_dir lora-partnership-ndf)/internal/process/document"
}


twdoc() {
  lora-schemagen -d -s 'http://localhost:8080/json-schema/business/document/dp-ndf-v0_8_0.schema.json?bundled=1' \
    -t "$(_lora_svc_dir lora-partnership-task-ndf)/internal/process/common"
}
pwdoc6() {
  lora-schemagen -d -s 'http://localhost:8080/json-schema/business/document/dp-ndf-v0_7_0.schema.json?bundled=1' \
    -t "$(_lora_svc_dir lora-partnership-ndf)/internal/process/document"
}
twdoc6() {
  lora-schemagen -d -s 'http://localhost:8080/json-schema/business/document/dp-ndf-v0_7_0.schema.json?bundled=1' \
    -t "$(_lora_svc_dir lora-partnership-task-ndf)/internal/process/common"
}
alias tmuxr='tmux source-file ~/.tmux.conf'
alias szz='source ~/.zshrc'
