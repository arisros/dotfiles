{
  "title": "tmux-style navigation (arisjirat dotfiles)",
  "rules": [
    {
      "description": "tmux prefix in the browser: Home (ArkButton thumb) / fn+Left / caps_lock, then 1-9 n p c x w s f : [ o l r z u ? & \u2014 Chrome & Brave only",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "home",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "tmux_browser_prefix",
                "value": 1
              }
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "tmux_browser_prefix",
                  "value": 0
                }
              }
            ]
          },
          "parameters": {
            "basic.to_delayed_action_delay_milliseconds": 2000
          },
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.brave\\.Browser$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_arrow",
            "modifiers": {
              "mandatory": [
                "fn"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "tmux_browser_prefix",
                "value": 1
              }
            }
          ],
