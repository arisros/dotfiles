# Copy to ~/.config/git/config.local. Never committed.
# git/.gitconfig includes it, so identity stays machine-local and this repo is
# identical everywhere.

# [user]
#     name = "<name>"
#     email = "<email>"

# A second account, routed by where the repo lives rather than which directory
# it is cloned into. insteadOf sends the org through the ssh alias from
# ssh/config.local.example; hasconfig matches the remote URL as written.
# [url "<alias>:<org>/"]
#     insteadOf = git@github.com:<org>/
#     insteadOf = https://github.com/<org>/
# [includeIf "hasconfig:remote.*.url:git@github.com:<org>/**"]
#     path = ~/.config/git/config.<name>
# [includeIf "hasconfig:remote.*.url:https://github.com/<org>/**"]
#     path = ~/.config/git/config.<name>
# [includeIf "hasconfig:remote.*.url:<alias>:<org>/**"]
#     path = ~/.config/git/config.<name>
