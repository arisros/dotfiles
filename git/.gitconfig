[user]
  name = "Aris Jirat"
  email = "arisjiratkurniawan@gmail.com"
[core]
  sshCommand = "ssh -i ~/.ssh/id_rsa_git_arisjirat -F /dev/null"


; ssh instead of https
[url "git@github.com:"]
    insteadOf = https://github.com/

[url "https://:@github.com"]
	insteadOf = https://github.com
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential

; Local, untracked overrides: identity and anything machine-specific.
; Missing file is not an error, so this is safe on a fresh machine.
[include]
    path = ~/.config/git/config.local
