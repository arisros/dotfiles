; [includeIf "gitdir:~/personal/"]
;     path = ~/.gitconfig-personal
;
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work
; [includeIf "gitdir:~/sandbox/"]
;     path = ~/.gitconfig-personal
;
; ; ; # TODO: swictcher
[user]
    name = "Redacted"
    email = "redacted@example.com"
[core]
	; honor ~/.ssh/config so Host aliases (github.com, github-redacted) work — they
	; already map to the right IdentityFile (id_ed25519 / id_redacted respectively)
	sshCommand = ssh -o StrictHostKeyChecking=accept-new
;     
; [user]
;   name = "Aris Jirat"
;   email = "arisjiratkurniawan@gmail.com"
; [core]
;   sshCommand = "ssh -i ~/.ssh/id_rsa_git_arisjirat -F /dev/null"


; ssh instead of https
[url "git@github.com:"]
	insteadOf = https://github.com/

; route redacted-org org through the github-redacted SSH alias (uses ~/.ssh/id_redacted)
[url "git@github-redacted:redacted-org/"]
	insteadOf = https://github.com/redacted-org/

[credential]
	; resolve via $PATH so this works on both /usr/local/bin (mac) and
	; /usr/bin or ~/.local/bin (Debian). Install the binary from
	; https://github.com/hickford/git-credential-oauth or similar.
	helper = git-credential-pat
[init]
	defaultBranch = main

[includeIf "gitdir:~/redacted/"]
    path = ~/redacted/.gitconfig


