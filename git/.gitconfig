; Identity is machine-local: see the [include] at the bottom and
; git/config.local.example for the shape.

; ssh instead of https
[url "git@github.com:"]
    insteadOf = https://github.com/

; Resolve gh from PATH: it is /opt/homebrew/bin/gh on macOS but /usr/bin/gh
; on Debian, and an absolute path makes the helper a no-op on the other OS.
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

; Local, untracked overrides: identity and anything machine-specific.
; config.overlay is for a private overlay repo. A missing file is not an
; error, so both are safe on a fresh machine.
[include]
    path = ~/.config/git/config.local
[include]
    path = ~/.config/git/config.overlay
