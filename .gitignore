# Ignore everything except explicitly tracked dotfiles


# Ignore backup files
*.swp
*.swo
*.bak
*.tmp

# Ignore system-specific files
.DS_Store
.Trash

# Ignore shell history files
.zsh_history
.bash_history

# Ignore SSH keys (security risk)
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/known_hosts

# Ignore Vim/Neovim swap and backup files
.viminfo
.vim/.netrwhist
.netrwhist

# Ignore macOS-specific files
*.localized
.AppleDouble
.LSOverride

# Ignore logs
*.log

# Build artifacts (cargo target dirs from install_rust_tools.sh, etc.)
target-install/
target/

# tmux plugins are managed by TPM (bootstrap_tpm in scripts/lib.sh) — never track them
tmux/plugins/

# macOS preference snapshots (not config; restore from git history if ever needed)
.preferences_backup/
.macos-defaults-backup.plist

.gitsecret/keys/random_seed
!*.secret
zsh/.secrets
