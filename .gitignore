# Ignore everything except explicitly tracked dotfiles


# Ignore backup files
*.swp
*.swo
*.bak
*.tmp

# Ignore system-specific files
.DS_Store
.Trash

# Ignore shell history files
.zsh_history
.bash_history

# Ignore SSH keys (security risk)
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/known_hosts
ssh/id_*
ssh/*.pem
ssh/*.key

# Ignore Vim/Neovim swap and backup files
.viminfo
.vim/.netrwhist
.netrwhist

# Ignore macOS-specific files
*.localized
.AppleDouble
.LSOverride

# Ignore logs
*.log

.gitsecret/keys/random_seed

# Ignore env and secret material
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
*.secret
*.secrets
**/*.secret
**/*.secrets

# Ignore certs and key stores
*.pem
*.key
*.p12
*.pfx
*.kdbx

zsh/.secrets

# --- Local modules and machine-local overrides -------------------------------
# The public repo carries the mechanism; the contents stay on the machine.
*.local
!*.local.example
ssh/config.local
zsh/.zshrcbackup

# Machine state dumps: never useful to anyone else, and they carry account,
# device and network details.
.preferences_backup/
.macos-defaults-backup.plist
*.settings.plist
