# Ignore everything except explicitly tracked dotfiles


# Ignore backup files
*.swp
*.swo
*.bak
*.tmp

# Ignore system-specific files
.DS_Store
.Trash

# Ignore shell history files
.zsh_history
.bash_history

# Ignore SSH keys (security risk)
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/known_hosts
ssh/id_*
ssh/*.pem
ssh/*.key

# Ignore Vim/Neovim swap and backup files
.viminfo
.vim/.netrwhist
.netrwhist

# Ignore macOS-specific files
*.localized
.AppleDouble
.LSOverride

# Ignore logs
*.log

.gitsecret/keys/random_seed

# Ignore env and secret material
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
*.secret
*.secrets
**/*.secret
**/*.secrets

# Ignore certs and key stores
*.pem
*.key
*.p12
*.pfx
*.kdbx

zsh/.secrets

# Tooling kerja — dipindah ke repo privat arisros/dotfiles-private,
# di-symlink balik ke sini. Jangan pernah masuk repo publik.
lora
zsh/.supertest
docs/supertest-toolkit.html

# File backup bertimestamp & state migrasi (bukan cuma *.bak)
*.bak.*
*.migrations.json
