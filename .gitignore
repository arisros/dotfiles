# Ignore everything except explicitly tracked dotfiles


# Ignore backup files
*.swp
*.swo
*.bak
*.tmp

# Ignore system-specific files
.DS_Store
.Trash

# Ignore shell history files
.zsh_history
.bash_history

# Ignore SSH keys (security risk)
.ssh/id_rsa
.ssh/id_rsa.pub
.ssh/known_hosts
ssh/id_*
ssh/*.pem
ssh/*.key

# Ignore Vim/Neovim swap and backup files
.viminfo
.vim/.netrwhist
.netrwhist

# Ignore macOS-specific files
*.localized
.AppleDouble
.LSOverride

# Ignore logs
*.log

.gitsecret/keys/random_seed

# Ignore env and secret material
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template
*.secret
*.secrets
**/*.secret
**/*.secrets

# Ignore certs and key stores
*.pem
*.key
*.p12
*.pfx
*.kdbx

zsh/.secrets

# --- Local modules and machine-local overrides -------------------------------
# The public repo carries the mechanism; the contents stay on the machine.
*.local
!*.local.example
ssh/config.local
zsh/.zshrcbackup

# Machine state dumps: never useful to anyone else, and they carry account,
# device and network details.
.preferences_backup/
.macos-defaults-backup.plist
*.settings.plist

# Context-specific tooling config: host lists, service names and profiles that
# belong to one employer. The generic config for these tools is tracked; these
# are not.
zsh/.blue_dev
zsh/.db_aliases_work
queuepeek/config.toml

# Generated by opencode on config migration.
*.json.bak.*
*.migrations.json

# Flutter version manager artifacts, including absolute symlinks into $HOME.
.fvm/

# Claude Code: the config is tracked, the state and the machine-specific
# instructions are not.
claude/CLAUDE.md
claude/projects/
claude/transcripts/
claude/sessions/
claude/history.jsonl
claude/*.log
claude/*.bak
claude/.credentials.json
