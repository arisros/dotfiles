# Copy to ~/.ssh/config.local and fill in. Never committed - this file only
# documents the shape, so a fresh machine knows what is expected to be there.
#
# ssh/config includes it before any Host block, so anything defined here wins
# and nothing about your actual machines has to live in a tracked file.

# Host <alias>
#     HostName <address>
#     User <login>
#     Port 22
#     IdentityFile ~/.ssh/<key>
#     StrictHostKeyChecking yes
#     # Only on hosts you own: lets them use this machine's keys, which never
#     # leave it. See docs/git-ssh.md.
#     ForwardAgent yes

# Plain github.com. Needed because ssh/config sets IdentitiesOnly yes for Host *,
# so no key is offered without an explicit IdentityFile. Tools that set their own
# GIT_SSH_COMMAND (lazy.nvim does) discard the -i in git's core.sshCommand, so a
# rewrite of https://github.com/ to ssh then authenticates with no key at all.
# Host github.com
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/<key>

# A second GitHub account, reached as <alias>:<org>/<repo>. On a host that only
# has the forwarded agent, copy just <key>.pub there: ssh reads it to pick that
# one key out of the agent.
# Host <alias>
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/<key>
