# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Personal GitHub Account
Host github.com-arisros
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_rsa_git_arisjirat

# Work GitHub Account (BFI)
Host github.com-bfi-finance
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_github_bfi

Host arkdefender
    HostName 159.65.15.126
    User root
    IdentityFile ~/.ssh/id_ed25519_github
    SetEnv TERM=xterm-256color


Host vps
    HostName 159.65.15.126
    User root
    IdentityFile ~/.ssh/id_ed25519_github

Host hostme
    HostName 10.10.0.1
    User root
    IdentityFile ~/.ssh/id_sys
    IdentitiesOnly yes
    ProxyJump vps
    SetEnv TERM=xterm-256color
    SetEnv TERM=xterm-kitty
    SetEnv COLORTERM=truecolor
    SetEnv KITTY_WINDOW_ID=1


Host sys_hostme
    HostName 10.10.0.1
    User sys_hostme
    IdentityFile ~/.ssh/id_sys
    IdentitiesOnly yes
    ProxyJump vps


    

Host bri
    HostName 188.166.188.121
    User root
    IdentityFile ~/.ssh/id_sys
    IdentitiesOnly yes
    SetEnv TERM=xterm-256color
    SetEnv TERM=xterm-kitty
    SetEnv COLORTERM=truecolor
    SetEnv KITTY_WINDOW_ID=1


# Cache key passphrases in ssh-agent + macOS Keychain (survives reboot).
# Keep this Host * block LAST — ssh uses first-match-wins per option.
Host *
    AddKeysToAgent yes
    UseKeychain yes

Host macoffice
      HostName 127.0.0.1
      Port 2222
      User mac-098183      
      IdentityFile ~/.ssh/id_ed25519_github
      IdentitiesOnly yes
      ProxyJump vps
      SetEnv TERM=xterm-256color
      SetEnv TERM=xterm-kitty
      SetEnv COLORTERM=truecolor
      SetEnv KITTY_WINDOW_ID=1



Host runpod
    HostName 154.54.102.29
    Port 13336
    User root
    IdentityFile ~/.ssh/id_runpod
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
