<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ssh-agent</string>

    <!-- Every key whose passphrase is in the keychain, so the agent already
         holds them all before anything forwards it to another host. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh-add</string>
        <string>--apple-load-keychain</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
